# Calendar ICS URLs for the AwesomeWM calendar widget.
# Copy this file to calendars.env and fill in your secret URLs.
# Any key ending in _ICS_URL is picked up automatically.
#
# Google Calendar: Settings > [calendar] > "Secret address in iCal format"
# Outlook:         Settings > View all Outlook settings > Calendar > Shared calendars > Publish

GOOGLE_PERSONAL_ICS_URL=
GOOGLE_WORK_ICS_URL=
OUTLOOK_WORK_ICS_URL=
